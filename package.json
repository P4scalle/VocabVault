{
  "name": "@vocavault/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "npx nx serve vocavault",
    "build": "npx nx build vocavault",
    "build:prod": "npx nx build vocavault --configuration=production && npx sentry-cli sourcemaps inject dist/apps/vocavault/browser && npx sentry-cli sourcemaps upload dist/apps/vocavault/browser",
    "test": "npx nx run-many -t test",
    "test:coverage": "npx nx run-many -t test --coverage",
    "lint": "npx nx run-many -t lint",
    "format": "npx nx format:write",
    "format:check": "npx nx format:check",
    "e2e": "npx nx e2e vocavault-e2e",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@angular/animations": "~21.2.0",
