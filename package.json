    "papaparse": "^5.5.3",
    "primeicons": "^7.0.0",
    "rxjs": "~7.8.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "~2.1.2",
